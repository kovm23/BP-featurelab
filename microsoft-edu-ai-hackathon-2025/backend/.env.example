# Backend runtime config
FLASK_DEBUG=0
PORT=5000

# Local Ollama endpoint and fallback model.
# The UI can still send another model explicitly.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b
# API key for Ollama's OpenAI-compatible endpoint (default "ollama" works for local installs).
# OLLAMA_API_KEY=ollama
# Output token budgets. Set CUSTOM_LLM_MAX_COMPLETION_TOKENS=0 to omit the
# token-limit parameter for custom/OpenAI-compatible endpoints.
# OLLAMA_MAX_COMPLETION_TOKENS=2048
# CUSTOM_LLM_MAX_COMPLETION_TOKENS=8192
# Set to 0 to disable automatic CPU fallback when GPU model load fails.
# OLLAMA_CPU_FALLBACK=1

# LLM service switch: one env selects the service, one env supplies its key.
# Only the selected provider's key is needed. Per-request UI overrides still win.
# LLM_PROVIDER=ollama | anthropic | gemini   (default: ollama)
# ANTHROPIC_API_KEY=sk-ant-...   # used when LLM_PROVIDER=anthropic (default model claude-haiku-4-5)
# GEMINI_API_KEY=AIza...         # used when LLM_PROVIDER=gemini (default model gemini-2.5-flash)
# LLM_MODEL=...                  # optional model override for the selected provider
# Advanced: any other OpenAI-compatible endpoint instead of a preset:
# LLM_BASE_URL=https://api.openai.com
# LLM_API_KEY=sk-...

# Add every public frontend origin that should be allowed to call the backend.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://llmfeatures.vse.cz

# Optional but recommended in production.
# SECRET_KEY=replace-me
