# Docker Compose configuration (copy to `.env` — the real .env is gitignored).
#
# Default: everything runs locally in Docker incl. Ollama — leave this file empty/unset.
#
# --- LLM service switch ------------------------------------------------------
# One env selects the service, one env supplies its key. Only the selected
# provider's key is needed; the others may stay empty.
# With anthropic/gemini you can start just:  docker compose up -d backend frontend
# (no 6 GB model download, no slow CPU inference)
#
# LLM_PROVIDER=ollama          # default: local Ollama (model qwen2.5vl:7b)
# LLM_PROVIDER=anthropic       # default model: claude-haiku-4-5
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_PROVIDER=gemini          # default model: gemini-2.5-flash
# GEMINI_API_KEY=AIza...
#
# Optional model override for the selected provider:
# LLM_MODEL=claude-sonnet-5
#
# --- Advanced ----------------------------------------------------------------
# Any other OpenAI-compatible endpoint (e.g. OpenAI API):
# LLM_BASE_URL=https://api.openai.com
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-5-mini
#
# Native Ollama on macOS (faster dev; app in Docker, Ollama on the host):
# OLLAMA_BASE_URL=http://host.docker.internal:11434
#
# Different local model:
# OLLAMA_MODEL=qwen2.5vl:7b
